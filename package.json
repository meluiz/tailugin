{
  "name": "tailugin",
  "version": "1.0.0",
  "description": "A collection of Tailwind CSS v4 utilities — enter/exit animations, semantic state variants, OKLCH color palettes, and easing tokens.",
  "author": {
    "name": "meluiz",
    "email": "me@meluiz.com",
    "url": "https://meluiz.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/meluiz/tailugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meluiz/tailugin.git"
  },
  "bugs": {
    "url": "https://github.com/meluiz/tailugin/issues"
  },
  "keywords": [
    "css",
    "tailwind",
    "tailwindcss",
