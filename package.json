{
	"name": "tailugin",
	"description": "A collection of Tailwind CSS V4-ready utilities.",
	"version": "0.2.0",
	"author": {
		"name": "meluiz",
		"email": "me@meluiz.com",
		"url": "https://meluiz.com"
	},
	"files": [
		"plugins"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/meluiz/tailugin",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meluiz/tailugin.git"
	},
	"bugs": {
		"url": "https://github.com/meluiz/tailugin/issues"
	},
	"keywords": [
		"css",
		"plugin",
		"tailugin",
		"tailwind",
		"tailwindcss",
		"transition",
		"animate",
		"animatecss",
		"animate.css",
		"conditions",
		"condition",
		"conditioncss",
		"condition.css",
		"colors",
		"color-palette",
		"oklch",
		"easings",
		"easing",
		"easingcss",
		"easing.css"
	],
	"main": "./plugins/main.css",
	"unpkg": "./plugins/main.css",
	"jsdelivr": "./plugins/main.css",
	"exports": {
		".": {
			"default": "./plugins/main.css"
		},
		"./animate.css": {
			"default": "./plugins/animate/main.css"
		},
		"./colors.css": {
			"default": "./plugins/colors/main.css"
		},
		"./conditions.css": {
			"default": "./plugins/conditions/main.css"
		},
		"./easings.css": {
			"default": "./plugins/easings/main.css"
		}
	},
	"peerDependencies": {
		"tailwindcss": "^4"
	}
}
