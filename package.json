    "tailwind-v4",
    "animate",
    "animation",
    "enter-exit",
    "transition",
    "variants",
    "custom-variant",
    "data-attributes",
    "aria",
    "colors",
    "color-palette",
    "oklch",
    "easing",
    "easings",
    "preflight"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "plugin"
  ],
  "main": "./plugin/index.css",
  "style": "./plugin/index.css",
  "unpkg": "./plugin/index.css",
  "jsdelivr": "./plugin/index.css",
  "exports": {
    ".": {
      "default": "./plugin/index.css"
    },
    "./theme": {
      "default": "./plugin/theme/index.css"
