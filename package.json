    "./variants/calendar": {
      "default": "./plugin/variants/calendar.css"
    },
    "./variants/dark": {
      "default": "./plugin/variants/dark.css"
    },
    "./variants/disclosure": {
      "default": "./plugin/variants/disclosure.css"
